# Copy to .env and edit. Every value below is already the default, so an empty
# .env works fine for real hardware.

# Set true to run without an MM01 attached (Labs 1-4 work in simulator mode).
MM01_SIM_ENABLED=false
MM01_SIM_COUNT=1

# How often the browser is sent a new reading, in milliseconds.
# The device itself always converts at a fixed 80 samples/second.
MM01_POLL_INTERVAL_MS=200

# Scan for devices at startup.
MM01_AUTO_SCAN=true

# Recording. The folder recordings are written to, the default interval between
# recorded rows (50 ms = 20 rows a second; 12 ms is about the device's own
# 80 samples/second), and the point at which a recording stops itself so a
# forgotten one cannot fill the SD card.
MM01_RECORD_DIR=recordings
MM01_RECORD_INTERVAL_MS=50
MM01_RECORD_MAX_SECONDS=3600
